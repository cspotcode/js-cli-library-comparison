{
  "oxc.enable": true,
  "oxc.requireConfig": true,
  "editor.formatOnSave": true,

  // Do NOT enable by default! It'll format markdown in bad ways!
  "editor.defaultFormatter": null,

  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
